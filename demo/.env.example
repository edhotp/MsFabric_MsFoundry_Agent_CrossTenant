# =============================================================================
#  Fabric Cross-Tenant MVP — Single Configuration File
# =============================================================================
#  Cara pakai:
#    1. Copy file ini menjadi .env  (jangan commit .env ke git!)
#         Windows PowerShell:  Copy-Item .env.example .env
#         Linux / macOS:       cp .env.example .env
#    2. Isi semua nilai yang ditandai <...> di bawah.
#    3. Jalankan demo: lihat README.md.
#
#  Sumber autoritatif untuk arti setiap variabel:
#    - demo-mvp-plan.md  (root repo) — §6.3 dan §7
#    - proposal-agent-manager-cross-tenant.md — §6, §7.3
#
#  Tip: nilai bertanda [DEFAULT OK] umumnya tidak perlu diubah untuk demo.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. TENANT A — Microsoft Fabric host (organisasi yang punya data)
# -----------------------------------------------------------------------------
# GUID tenant Microsoft Entra yang menjadi host Fabric workspace & Data Agent.
# Cara cek: Azure portal → Microsoft Entra ID → Overview → "Tenant ID".
TENANT_A_ID=<guid-tenant-A>


# -----------------------------------------------------------------------------
# 2. MULTI-TENANT APP REGISTRATION  (didaftar di Tenant B, dipakai user Tenant A)
# -----------------------------------------------------------------------------
# Sumber: Entra portal → App registrations → <app Anda> → Overview / Certificates & secrets
#
# Catatan: App HARUS multi-tenant ("Accounts in any organizational directory")
# dan sudah di-admin-consent oleh admin Tenant A.
APP_CLIENT_ID=<guid-application-(client)-id>
APP_CLIENT_SECRET=<paste-dari-Certificates-&-secrets>

# Redirect URI yang sama persis dengan yang didaftarkan di Entra App Reg → Authentication.
# Untuk demo lokal cukup nilai di bawah ini. [DEFAULT OK]
APP_REDIRECT_URI=http://localhost:8000/auth/callback

# Scope Power BI Service (untuk akses Fabric Data Agent).
# Nilai ini static — jangan diubah. [DEFAULT OK]
# Sumber: https://learn.microsoft.com/azure/foundry/agents/how-to/tools/fabric
POWERBI_SCOPE=https://analysis.windows.net/powerbi/api/.default


# -----------------------------------------------------------------------------
# 3. MICROSOFT FABRIC DATA AGENT  (di Tenant A)
# -----------------------------------------------------------------------------
# Setelah Data Agent di-Publish di Fabric portal, copy "Published URL".
# Format URL bervariasi per environment & region — biarkan apa adanya dari portal.
# Contoh bentuk URL:
#   https://<environment>.fabric.microsoft.com/groups/<workspace_id>/aiskills/<artifact_id>
# Sumber: https://learn.microsoft.com/fabric/data-science/data-agent-end-to-end-tutorial
FABRIC_AGENT_PUBLISHED_URL=<paste-Published-URL-lengkap-dari-Fabric-portal>

# Workspace ID dan Agent (artifact) ID — bisa diambil dari URL di atas
# atau dari Fabric portal → Data Agent → Settings.
FABRIC_WORKSPACE_ID=<guid-workspace>
FABRIC_AGENT_ID=<guid-artifact-id>

# Timeout polling Assistants API run (detik). MS Learn end-to-end tutorial pakai 300. [DEFAULT OK]
FABRIC_POLL_TIMEOUT_SECONDS=300

# Interval polling status run (detik). [DEFAULT OK]
FABRIC_POLL_INTERVAL_SECONDS=2


# -----------------------------------------------------------------------------
# 4. AZURE OPENAI  (di Tenant B — backend LLM untuk Agent Manager)
# -----------------------------------------------------------------------------
# Sumber: Azure portal → resource Azure OpenAI Anda → Keys and Endpoint
AZURE_OPENAI_ENDPOINT=https://<resource-name>.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=<nama-deployment-mis-gpt-4.1>
AZURE_OPENAI_API_VERSION=2024-10-21

# Mode autentikasi ke Azure OpenAI: "apikey" atau "azurecli".
#   - apikey   : paling mudah untuk demo — isi AZURE_OPENAI_API_KEY di bawah.
#   - azurecli : pakai identitas `az login` developer (tidak perlu key).
# [DEFAULT OK untuk demo cepat: apikey]
AZURE_OPENAI_AUTH_MODE=apikey

# Hanya wajib kalau AZURE_OPENAI_AUTH_MODE=apikey. Kosongkan kalau pakai azurecli.
AZURE_OPENAI_API_KEY=<paste-key-dari-Azure-portal>


# -----------------------------------------------------------------------------
# 5. SERVER  (uvicorn / FastAPI)
# -----------------------------------------------------------------------------
# Host & port harus konsisten dengan APP_REDIRECT_URI di atas. [DEFAULT OK]
APP_HOST=127.0.0.1
APP_PORT=8000
APP_RELOAD=true


# -----------------------------------------------------------------------------
# 6. SESSION  (in-memory cookie session)
# -----------------------------------------------------------------------------
# Random hex 32+ karakter, dipakai untuk tanda tangan cookie session.
# Generate baru:
#    PowerShell:  -join ((1..64) | ForEach-Object { '{0:x}' -f (Get-Random -Max 16) })
#    Linux/macOS: openssl rand -hex 32
SESSION_SECRET_KEY=<generate-random-hex-min-32-char>

# Masa berlaku session (menit). [DEFAULT OK]
SESSION_TTL_MINUTES=60


# -----------------------------------------------------------------------------
# 7. LOGGING
# -----------------------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR. Pakai DEBUG saat troubleshooting auth/token. [DEFAULT OK]
LOG_LEVEL=INFO
