# ====================================================================
# Fabric Cross-Tenant Demo — environment variables
# ====================================================================
# Copy this file to `.env` (same folder), then fill in the two values.
# `.env` is git-ignored — never commit real values.
# --------------------------------------------------------------------

# Tenant ID of TENANT A — the Microsoft Entra tenant that owns the
# Microsoft Fabric workspace where the Data Agent is published.
# Find it in Azure portal → Microsoft Entra ID → Overview → Tenant ID.
# Format: GUID (e.g. aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee)
TENANT_ID=

# Published URL of the Fabric Data Agent (Assistants-API style).
# Find it in Fabric → open your published Data Agent → Settings →
# "Published endpoint" (copy the OpenAI URL).
# Format: https://api.fabric.microsoft.com/v1/workspaces/<workspace-id>/dataagents/<agent-id>/aiassistant/openai
DATA_AGENT_URL=
