# ====================================================================
# Fabric Cross-Tenant Demo (Orchestrator) — environment variables
# ====================================================================
# Copy this file to `.env` (same folder), then fill in the values.
# `.env` is git-ignored — never commit real values.
# --------------------------------------------------------------------

# -- Tenant + Fabric data agent (same as ../demo) ---------------------

# Tenant ID of TENANT A — the Microsoft Entra tenant that owns the
# Microsoft Fabric workspace where the Data Agent is published.
# Format: GUID (e.g. aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee)
TENANT_ID=

# Published URL of the Fabric Data Agent (Assistants-API style).
# Fabric → open published Data Agent → Settings → "Published endpoint".
DATA_AGENT_URL=

# -- Manager LLM (Azure OpenAI, Entra ID auth — no API key needed) ----
# The manager agent uses Azure OpenAI and reuses the SAME interactive
# browser sign-in as the Fabric call, so the user signs in only once.
#
# Make sure the signed-in user has the
# "Cognitive Services OpenAI User" role on the AOAI resource.

# e.g. https://my-aoai-resource.openai.azure.com
AZURE_OPENAI_ENDPOINT=

# Deployment name of your chat model (e.g. gpt-4o-mini, gpt-4.1, etc.)
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini

# AOAI API version. 2024-12-01-preview or newer recommended.
AZURE_OPENAI_API_VERSION=2024-12-01-preview
