# ====================================================================
# Fabric Cross-Tenant Demo (Orchestrator) — environment variables
# ====================================================================
# Copy this file to `.env` (same folder), then fill in the values.
# `.env` is git-ignored — never commit real values.
# --------------------------------------------------------------------

# -- Tenant + Fabric data agent (same as ../demo) ---------------------

# Tenant ID of TENANT A — the Microsoft Entra tenant that owns the
# Microsoft Fabric workspace where the Data Agent is published.
# Format: GUID (e.g. aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee)
TENANT_ID=

# Published URL of the Fabric Data Agent (Assistants-API style).
# Fabric → open published Data Agent → Settings → "Published endpoint".
DATA_AGENT_URL=

# -- Manager LLM (Azure AI Foundry, Entra ID auth — no API key needed) -
# The manager agent uses the Azure AI Foundry v1 OpenAI endpoint with
# an interactive browser sign-in (no key). When Foundry and Fabric live
# in the SAME tenant, one sign-in covers both. When they live in
# DIFFERENT tenants (e.g. Fabric in a partner's tenant, Foundry in your
# own home tenant), set LLM_TENANT_ID below — the app then opens a
# second browser sign-in for the Foundry tenant.
#
# The signed-in user must have permission to call the model deployment
# on the Foundry resource (e.g. "Azure AI User" or "Cognitive Services
# User" role). The Entra scope requested is
# https://ai.azure.com/.default (handled by the orchestrator).

# Full Foundry v1 OpenAI base URL (must end with /openai/v1)
# e.g. https://foundry-zeroquery-poc.services.ai.azure.com/openai/v1
AZURE_OPENAI_ENDPOINT=

# Model deployment name on the Foundry resource (e.g. gpt-5.4-mini,
# gpt-4o-mini, gpt-4.1, etc.)
AZURE_OPENAI_DEPLOYMENT=gpt-5.4-mini

# Optional — tenant the Foundry resource lives in. Leave empty when
# Foundry is in the user's home/default tenant. Set this when Foundry
# is in a DIFFERENT tenant from `TENANT_ID` above.
LLM_TENANT_ID=
